{
  "name": "novamark-automation",
  "version": "0.1.0",
  "description": "Cypress AI Test Studio — automation suite for novamark-fe (and portable to future projects)",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed --no-exit"
  },
  "keywords": [
    "cypress",
    "bdd",
    "cucumber",
    "test-studio",
    "ai-testing"
  ],
  "author": "Arun Gounder <arun.gounder@thecontrast.in>",
  "license": "UNLICENSED",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/support/step_definitions/**/*.{ts,js}"
    ],
    "json": {
      "enabled": true,
      "output": ".test-studio/last-run.json"
    },
    "html": {
      "enabled": false
    }
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^25.6.2",
    "cypress": "^14.5.4",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3"
  }
}
