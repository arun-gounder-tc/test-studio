# Test Studio backend env config — copy to .env and fill in
PORT=3001

# --- AI provider keys ---
# Set EITHER (or BOTH). Provider is auto-picked from the model name:
#   claude-* models  → ANTHROPIC_API_KEY
#   gpt-* / o1-* / o3-* models → OPENAI_API_KEY
# Models whose key is missing will appear disabled in the UI dropdown.

# Anthropic — generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — generate at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Postgres (Sequelize) ---
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# (Note: cypress/, config/, .workspace/, .test-studio/ now live inside studio-server/.
#  All paths resolve relative to studio-server itself — no PROJECT_ROOT override needed.)

# Default model when UI does not specify one.
# Examples: gpt-4o-mini, gpt-4o, claude-sonnet-4-6, claude-opus-4-7
DEFAULT_MODEL=gpt-4o-mini
DEBUG_MODEL=gpt-4o

# Studio UI origin (CORS allow)
STUDIO_UI_ORIGIN=http://localhost:4300

# --- Object storage (Phase B) ---
# Driver: 'minio' (default) or 'local' (writes to .test-studio/storage/, no MinIO required)
STORAGE_DRIVER=minio

# MinIO / S3-compatible endpoint (used when STORAGE_DRIVER=minio).
# Fill these with your deployed MinIO URL + credentials.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=test-studio

# Set to 'true' to keep local copies of run artifacts after upload (debug)
KEEP_LOCAL_ARTIFACTS=false

# Only required when STORAGE_DRIVER=local — base URL for the file proxy.
SERVER_BASE_URL=http://localhost:3001
